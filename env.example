# Copia este archivo como .env y completa los valores.

# Primer administrador: se crea automáticamente al arrancar si no existe ninguno.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Inteligencia artificial (elige UNA). Gemini tiene capa gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # si el modelo deja de existir, la app elige sola el Flash vigente
# Grok (xAI): clave en console.x.ai. Si defines XAI_API_KEY se usa Grok. XAI_MODEL es opcional
# (si se deja vacío, la app elige sola el modelo más económico disponible).
# XAI_API_KEY=
# XAI_MODEL=

# Alternativa gratuita: Groq https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Cualquier API compatible con OpenAI (OpenRouter, DeepSeek, OpenAI…)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=

# Consultas de IA por usuario y por día
AI_DAILY_TRIAL=3
AI_DAILY_PAID=150

# Contacto que ven los usuarios de prueba para comprar el plan
CONTACT_WHATSAPP=+57
CONTACT_EMAIL=

APP_NAME=Radar Solar
# Carpeta donde se guardan usuarios, documentos y datos actualizados (en el hosting, un volumen persistente)
DATA_DIR=./storage
PORT=3000
# Costo de referencia por kWp instalado (COP). También se cambia en Administración > Ajustes.
CAPEX_COP_KWP=3800000

# Opcional, para hostings gratuitos sin disco (Render Free): usuarios que se recrean en cada arranque.
# Formato usuario:clave:rol:perfil separados por punto y coma. Ejemplo:
# SEED_USERS=demo-instalador:ClaveSegura1:paid:instalador;demo-prueba:ClaveSegura2:trial:todos
SEED_USERS=
