# Copia este archivo como .env y completa los valores.

# Primer administrador: se crea automáticamente al arrancar si no existe ninguno.
ADMIN_USER=admin
# Mínimo 15 caracteres (una frase larga sirve). Al primer ingreso pedirá activar la verificación en dos pasos.
ADMIN_PASSWORD=
# Si el administrador olvidó la contraseña o perdió la verificación en dos pasos: pon ADMIN_RESET=1, vuelve a desplegar,
# ingresa con ADMIN_USER y ADMIN_PASSWORD (pedirá cambiarla y activar de nuevo el segundo factor) y QUITA esta variable.
# ADMIN_RESET=1

# Inteligencia artificial (elige UNA). Gemini tiene capa gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # si el modelo deja de existir, la app elige sola el Flash vigente
# Grok (xAI): clave en console.x.ai. Si defines XAI_API_KEY se usa Grok. XAI_MODEL es opcional
# (si se deja vacío, la app elige sola el modelo más económico disponible).
# XAI_API_KEY=
# XAI_MODEL=

# Alternativa gratuita: Groq https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Cualquier API compatible con OpenAI (OpenRouter, DeepSeek, OpenAI…)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=

# Consultas de IA por usuario y por día
AI_DAILY_TRIAL=3
AI_DAILY_PAID=150

# Contacto que ven los usuarios de prueba para comprar el plan
CONTACT_WHATSAPP=+57
CONTACT_EMAIL=

APP_NAME=Radar Solar
# Carpeta donde se guardan usuarios, documentos y datos actualizados (en el hosting, un volumen persistente)
DATA_DIR=./storage
PORT=3000
# Costo de referencia por kWp instalado (COP). También se cambia en Administración > Ajustes.
CAPEX_COP_KWP=3800000

# Opcional, para hostings gratuitos sin disco (Render Free): usuarios que se recrean en cada arranque.
# Formato usuario:clave:rol:perfil separados por punto y coma. Ejemplo:
# Las claves de menos de 15 caracteres funcionan, pero obligan a cambiarlas al ingresar.
# SEED_USERS=demo-instalador:una-frase-larga-de-ejemplo:paid:instalador:Empresa SAS
SEED_USERS=

# ---------------- Seguridad ----------------
# Clave para firmar enlaces compartidos. Genera una larga y aleatoria; si cambia, los enlaces anteriores dejan de funcionar.
SESSION_SECRET=
NODE_ENV=production
# HTTPS obligatorio (se activa solo en producción). HSTS: actívalo cuando el dominio definitivo ya funcione con HTTPS.
# FORCE_HTTPS=1
# HSTS=1
# Marca el disco como persistente (montado en DATA_DIR). Sin esto la app avisa que los registros legales se pueden perder.
# PERSISTENT_STORAGE=1

# ---------------- Copias de seguridad cifradas ----------------
# 64 caracteres hexadecimales o una frase de 24+ caracteres. Guárdala FUERA del hosting: sin ella no se puede restaurar.
BACKUP_KEY=
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14
# Copia fuera del hosting (Cloudflare R2, Backblaze B2, S3…)
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=radar-solar/

# ---------------- Plan y condiciones comerciales ----------------
PLAN_PRECIO_COP=750000
# Texto que se muestra junto al precio. Ejemplo: "IVA incluido" o "Más IVA (19 %)". Confírmalo con tu contador.
PLAN_IMPUESTOS=
# Por cuánto tiempo da acceso el pago único. Ejemplo: "12 meses desde la activación".
LEGAL_VIGENCIA_PLAN=
# Qué pasa si el servicio se descontinúa (aviso previo, exportación, reembolso proporcional…)
LEGAL_DESCONTINUACION=

# ---------------- Responsable del tratamiento (aparecen en las políticas) ----------------
# Razón social, NIT, matrícula, domicilio, dirección y web ya vienen en server/config.js (certificado de la Cámara de Comercio).
# Defínelas aquí solo si cambian. El correo y el teléfono del canal de datos personales también vienen por defecto.
# LEGAL_RAZON_SOCIAL=
# LEGAL_NIT=
# LEGAL_MATRICULA=
# LEGAL_DOMICILIO=
# LEGAL_DIRECCION=
# LEGAL_CORREO_DATOS=
# LEGAL_TELEFONO=
# LEGAL_WEB=
LEGAL_RETENCION_CONSENTIMIENTOS=
LEGAL_RETENCION_SOLICITUDES=
LEGAL_PROVEEDOR_RESPALDO=
LEGAL_PAIS_RESPALDO=
# Estado de los contratos de transmisión con proveedores (hosting, IA, respaldo)
LEGAL_ESTADO_CONTRATOS=
